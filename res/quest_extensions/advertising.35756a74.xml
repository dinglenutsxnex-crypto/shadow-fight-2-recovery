<?xml version="1.0" encoding="utf-8"?>
<Quests>
  <Include File="quest_extensions/cashback_quests.xml" />

  <Quest Name="ShowAd" Unresumable="1" Priority="-100" Group="Advertising">
    <Events>
      <FightEnd />
    </Events>
    <Conditions>
      <Equal Not="1" Value1="_$FightResult" Value2="Surrender" />
      <Equal Value1="?Fight[_$Fight].Zone" Value2="Punchbag" Not="1" />
      <Or>
        <Equal Value1="?Fight[_$Fight].Zone" Value2="ZONE_1" Not="1" />
        <GreaterEqual Value1="?Fight[ZONE_1|BOSS_LYNX|3].WinCount" Value2="1" />
      </Or>
      <Equal Value1="_$Fight" Value2="ZONE_6|FINAL_BATTLE|1" Not="1"/>
      <Equal Value1="?SysInfo[].AdvertisingSupport" Value2="1" />
      <Greater Not="1" Value1="?UniformIntRandom[1,100]" Value2="?SessionSettings[].AdvertRate" />
    </Conditions>
    <Actions>
      <ShowAd Type="Interstitial" Lock="Visible" >
        <Error />
        <Success />
      </ShowAd>
    </Actions>
  </Quest>

  <Quest Name="EnergyRefillShowAdVideo" Unresumable="1">
    <Events>
      <Activate />
    </Events>
    <Conditions>
      <Equal Value1="_$ActionID" Value2="EnergyRefillShowAdVideo" />
      <Equal Value1="?SysInfo[].AdvertisingSupport" Value2="1" />
    </Conditions>
    <Actions Place="Map">
      <If>
        <Conditions>
          <Equal Value1="?SysInfo[].Connection" Value2="1" />
        </Conditions>
        <Then>
          <ShowAd Type="Video" Lock="Visible">
            <Error>
              <Dialog Type="NoAvatar" Title="dlgNotAvaliableTitle">
                <Line Text="dlgNotAvaliableMessage" ButtonText="OK" />
                <Button Type="Left" Color="Beige" Text="OK" />
              </Dialog>
              <SetVariable Scope="Users" Name="ShowVideoError" Value="1" />
              <Activate ActionID="EnergyRefillDialogue" />
            </Error>
            <Success>
              <SetVariable Scope="Users" Name="ShowVideoError" Value="0" />
            </Success>
          </ShowAd>
        </Then>
        <Else>
          <Dialog Type="NoAvatar" Title="dlgNotNetworkTitle">
            <Line Text="dlgNotNetworkMessage" ButtonText="OK" />
            <Button Type="Left" Color="Beige" Text="OK" />
          </Dialog>
          <SetVariable Scope="Users" Name="ShowVideoError" Value="1" />
          <Activate ActionID="EnergyRefillDialogue" />
        </Else>
      </If>
    </Actions>
  </Quest>

