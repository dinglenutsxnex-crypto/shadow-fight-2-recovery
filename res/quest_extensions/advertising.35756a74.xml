  <Quest Name="SurvivalRestartInit" Unresumable="1">
    <Events>
      <ApplicationStart />
    </Events>
    <Conditions>
      <Equal Value1="?SysInfo[].AdvertisingSupport" Value2="1" />
    </Conditions>
    <Actions>
      <!-- Выставляем дефолтное значение лимита на просмотр SurvivalRestartRewardedVideo за один бой -->
      <SetVariable Scope="Users" Name="SurvivalRestartLimitPerFight" Value="1" />
      <SetVariable Scope="Users" Name="SurvivalRestartTimerValue" Value="5" />
    </Actions>
  </Quest>

  <Quest Name="SurvivalRestartResetCounterPerFight" Unresumable="1">
    <Events>
      <FightEnd />
    </Events>
    <Conditions>
      <Equal Value1="?SysInfo[].AdvertisingSupport" Value2="1" />
      <Equal Value1="?Fight[_$Fight].Type" Value2="SURVIVAL" />
    </Conditions>
    <Actions>
      <!-- Сбрасываем текущий счетчик просмотров SurvivalRestartRewardedVideo за один бой -->
      <SetVariable Scope="Global" Name="SurvivalRestartCounterPerFight" Value="0" />
    </Actions>
  </Quest>

  <Quest Name="SurvivalRestartActivate" Unresumable="1">
    <Events>
      <FightPreEnd />
    </Events>
    <Conditions>
      <Equal Value1="?SysInfo[].AdvertisingSupport" Value2="1" />
      <Equal Value1="?Fight[_$Fight].Type" Value2="SURVIVAL" />
      <Equal Value1="_$FightResult" Value2="Loss" />
      <Equal Value1="?AdAvailable[SurvivalRestart]" Value2="1" />
      <Less Value1="_SurvivalRestartCounterPerFight" Value2="_SurvivalRestartLimitPerFight" />
    </Conditions>
    <Actions>
      <!-- Заводим таймер и создаем диалог в отдельном квесте, вызываемом через Activate. 
      Т.к. такие квесты выполняются из Update, это позволит создать диалог, 
      затем обновить позицию таймера в диалоге на том же фрейме (позиция таймеров 
      относительно границ текста также обновляется из Update), чтобы избежать дерганья -->
      <Activate ActionID="SurvivalRestartShowDialog" />
    </Actions>
  </Quest>

  <Quest Name="SurvivalRestartShowDialog" Unresumable="1">
    <Events>
      <Activate />
    </Events>
    <Conditions>
      <Equal Value1="?SysInfo[].AdvertisingSupport" Value2="1" />
      <Equal Value1="_$ActionID" Value2="SurvivalRestartShowDialog" />
    </Conditions>
    <Actions>
      <ActivateTimer Name="Timer_SurvivalRestartRewardedVideo" Value="_SurvivalRestartTimerValue" />
      <Dialog Type="Multiline" Title="dlgSurvivalRestartRewardedVideoTitle" Image="img_video" ImageScale="0.55" >
        <Line Text="dlgSurvivalRestartRewardedVideo">
          <Timer Name="Timer_SurvivalRestartRewardedVideo" />
        </Line>
        <Button Type="Right" Color="Beige" Text="OK">
          <EndTimer Name="Timer_SurvivalRestartRewardedVideo" />
          <If>
            <Conditions>
              <Equal Value1="?SysInfo[].Connection" Value2="1" />
            </Conditions>
            <Then>
              <ShowAd Type="SurvivalRestart" Lock="Visible">
                <Error>
                  <Dialog Type="NoAvatar" Title="dlgNotAvaliableTitle">
                    <Line Text="dlgNotAvaliableMessage" ButtonText="OK" />
                    <Button Type="Left" Color="Beige" Text="OK" />
                  </Dialog>
                  <SetVariable Scope="Users" Name="ShowVideoError" Value="1" />
                  <!-- Запускаем FightEnd с небольшим Delay, чтобы квесты добавленные в очередь обработки не отработали сразу в бою -->
                  <FightEnd Delay="0.05" />
                </Error>
                <Cancel>
                  <!-- Запускаем FightEnd с небольшим Delay, чтобы квесты добавленные в очередь обработки не отработали сразу в бою -->
                  <FightEnd Delay="0.05" />
                </Cancel>
                <Success>
                  <SetVariable Scope="Global" Name="SurvivalRestartCounterPerFight" Value="_SurvivalRestartCounterPerFight + 1" />
                  <SetVariable Scope="Users" Name="ShowVideoError" Value="0" />
                  <FightRestartRound PlayerLife="1" />
                </Success>
              </ShowAd> 
            </Then>
            <Else>
              <Dialog Type="NoAvatar" Title="dlgNotNetworkTitle">
                <Line Text="dlgNotNetworkMessage" ButtonText="OK" />
                <Button Type="Left" Color="Beige" Text="OK" />
              </Dialog>
              <SetVariable Scope="Users" Name="ShowVideoError" Value="1" />
              <!-- Запускаем FightEnd с небольшим Delay, чтобы квесты добавленные в очередь обработки не отработали сразу в бою -->
              <FightEnd Delay="0.05" />
            </Else>
          </If>
        </Button>
        <Button Type="Left" Color="Beige" Text="CANCEL">
          <EndTimer Name="Timer_SurvivalRestartRewardedVideo" />
          <!-- Запускаем FightEnd с небольшим Delay, чтобы квесты добавленные в очередь обработки не отработали сразу в бою -->
          <FightEnd Delay="0.05" />
        </Button>
      </Dialog>
    </Actions>
  </Quest>
</Quests>