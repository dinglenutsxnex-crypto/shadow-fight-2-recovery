  <Quest Name="StarterPackBought">
    <Events>
      <Activate />
    </Events>
    <Conditions>
      <Equal Value1="_$ActionID" Value2="StarterPackBoughtFirstSuperItem" />
      <Equal Value1="_FirstSuperItemFlag" Value2="1"/>
      <Operator Type="Or">
        <GreaterEqual Value1="?Item[Pack_Starter].Quantity" Value2="1" />
        <GreaterEqual Value1="?Item[Pack_Starter_2].Quantity" Value2="1" />
      </Operator>
    </Conditions>
    <Actions>
      <Activate ActionID="StarterPackGive" />
    <Activate ActionID="StarterPackGoToShop" />
    </Actions>
  </Quest>

  <Quest Name="StarterPackGive">
    <Events>
      <Activate />
    </Events>
    <Conditions>
      <Equal Value1="_$ActionID" Value2="StarterPackGive" />
    </Conditions>
    <Actions>
      <GiveItem Name="?Concat[WEAPON_STARTER_PACK_TONFA|,?Sum[?Multi[100,?Player[].Level],30]]" PutOn="1" Quantity="1" />
      <GiveItem Name="?Concat[HELM_XMAS14_HORNS|,?Sum[?Multi[100,?Player[].Level],30]]" PutOn="1" Quantity="1" />
      <SetVariable Name="BestAcquiredWeaponLevel" Scope="Users" Value="?Purchase[WEAPON_STARTER_PACK_TONFA].UpgradeLevel" />
      <SetVariable Name="BestAcquiredWeaponLevel" Scope="Users" Value="?Purchase[HELM_XMAS14_HORNS].UpgradeLevel" />
      <SetVariable Name="StarterPackOfferEnded" Scope="Users" Value="1" />
      <EndTimer Name="Timer_StarterPack"/>
      <HideMapButton Name="Button_StarterPack"/>
      <Activate ActionID="AllStarterPacks_SilentUpdate" />
      <UpdateShopItems />
      <OpenShop Tab="Weapon" Item="WEAPON_STARTER_PACK_TONFA"/>
    </Actions>
  </Quest>
  
  
