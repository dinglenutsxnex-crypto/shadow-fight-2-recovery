  </Quest>
  
  <!-- перезапускаем проверку, если игрок перешел в новую зону, что бы паки довыдать, до которых он дошел (если покупал) -->
  <Quest Name="SilentUpdate_ForcedRestart">
    <Events>
      <FightEnd />
    </Events>
    <Conditions>
      <Equal Value1="_$FightResult" Value2="Win" />
      <Or>
         <Equal Value1="_$Fight" Value2="ZONE_1|BOSS_LYNX|6" />
         <Equal Value1="_$Fight" Value2="ZONE_2|BOSS_HERMIT|6" />
         <Equal Value1="_$Fight" Value2="ZONE_3|BOSS_BUTCHER|6" />
         <Equal Value1="_$Fight" Value2="ZONE_4|BOSS_WASP|6" />
         <Equal Value1="_$Fight" Value2="ZONE_5|BOSS_HUNTRESS|6" />
         <Equal Value1="_$Fight" Value2="ZONE_6|BOSS_SAMURAI|6" />
      </Or>
    </Conditions>
    <Actions>
        <SetVariable Scope="Global" Name="SilentUpdate_ForcedStart_Checked" Value="0" />
    </Actions>
  </Quest>
  
   <!-- активируем проверку итемов по заходу в магазин. до этого, квест AllStarterPacks_SilentUpdate запускался только после покупки пака -->
  <Quest Name="SilentUpdate_ForcedStart">
    <Events>
      <ChangeTab />
    </Events>
    <Conditions>
      <Equal Value1="_$SceneTo" Value2="Shop" />
    <Equal Value1="_SilentUpdate_ForcedStart_Checked" Value2="1" Not="1" />
    </Conditions>
    <Actions>
    <Activate ActionID="AllStarterPacks_SilentUpdate" />
    </Actions>
  </Quest>
  
  <!-- fix restore all or equivalent - verify and give items from packs -->
  <Quest Name="AllStarterPacks_SilentUpdate">
    <Events>
    <Activate />
    </Events>
    <Conditions>
      <Equal Value1="_$ActionID" Value2="AllStarterPacks_SilentUpdate" />
      <!-- <Equal Value1="?SysInfo[].F2P" Value2="1" /> -->
      <Equal Value1="_$StoryTutorialStep" Value2="END" />
      <Equal Value1="?SysInfo[].ChinaF2P" Value2="0" />
      <Equal Value1="?Player[].HasPayments" Value2="1" />   <!-- for player that do not pay it will be faster. All packs that are restored here is paid-->
