<?xml version="1.0" encoding="utf-8"?>
<Quests>
  
  <!-- Starter Pack Promotion-->
  <Quest Name="StarterPackLaunch" Priority="-20">
    <Events>
      <FightEnd />
    </Events>
    <Conditions>
      <Equal Value1="?SysInfo[].ChinaF2P" Value2="0" />
      <Equal Value1="_$Fight" Value2="ZONE_1|Tournament|2" />
      <Equal Value1="_$FightResult" Value2="Win" />
      <Equal  Value1="?Item[WEAPON_STARTER_PACK_TONFA].Quantity" Value2="0" />
      <Greater Not="1" Value1="?Timer[Timer_StarterPack].Value" Value2="0" />
      <Greater Not="1" Value1="?Timer[Timer_FirstPayment].Value" Value2="0" />
      <Greater Not="1" Value1="?Timer[Timer_RepeatPayment].Value" Value2="0" />
      <Greater Not="1" Value1="?Timer[Timer_IncreasePayment].Value" Value2="0" />
      <Greater Not="1" Value1="?Timer[sale_Timer].Value" Value2="0" />
    </Conditions>
    <Actions Place="Map">
      <Activate ActionID="StarterPackDialogLaunch" />
    </Actions>
  </Quest>

  <Quest Name="StarterPackPress">
    <Events>
      <MapButtonPress />
    </Events>
    <Conditions>
      <Equal Value1="_$ButtonName" Value2="Button_StarterPack" />
    </Conditions>
    <Actions>
      <Activate ActionID="StarterPackDialog" />
    </Actions>
  </Quest>

  <Quest Name="StarterPackDialogLaunch" Unresumable="1">
    <Events>
      <Activate />
    </Events>
    <Conditions>
      <Equal Value1="?SysInfo[].ChinaF2P" Value2="0" />
      <Equal Not="1" Value1="_TmpPackDialogState01" Value2="Ended" />
      <Equal Value1="_$ActionID" Value2="StarterPackDialogLaunch" />
      <Greater Not="1" Value1="_DiscipleFlag" Value2="0" />
    </Conditions>
    <Actions Place="Map">
      <If>
        <Conditions>
          <Or>
            <Equal Value1="_$LevelUp" Value2="0" />
            <Equal Value1="_TmpPackDialogState01" Value2="Run" />
          </Or>
        </Conditions>
        <Then>
          <ActivateTimer Name="Timer_StarterPack" Value="86400" />
          <ShowMapButton Name="Button_StarterPack" Image="starter_pack" Timer="Timer_StarterPack" ShowType="Story" />
          <Dialog Type="Multiline" Title="dlgStarterPackTitle" Image="starter_pack2">
            <Line Text="dlgStarterPackOffer1{img::MiscSprites.tick_red}"/>
            <Line Text="dlgStarterPackOffer2{img::MiscSprites.tick_red}{img::MiscSprites.ruby}{30}"/>
            <Line Text="dlgStarterPackOffer3{img::MiscSprites.tick_red}{img::MiscSprites.gold}{1000}"/>
            <Line Text="dlgStarterPackOffer4{img::MiscSprites.tick_red}" Hide="?SysInfo[].AdvertisingSupport == 0"/>
            <Line Text="dlgStarterPackOffer5{img::MiscSprites.tick_red}"/>
            <PriceLine Text="dlgStarterPackPrice{?Item[Pack_Starter].RealPrice}" TextColor="0xfefe95" />
            <Button Type="Right" Color="Green" Text="dlgBuyButton">
              <SetVariable Scope="Users" Name="TmpBuyingValue" Value="Pack_Starter" />
              <BuyItem Name="Pack_Starter" Currency="Real" />
            </Button>
            <Button Type="Left" Color="Red" Text="dlgLaterBtn" >
              <Dialog Type="Multiline" Title="dlgStarterPackTitle" Image="starter_pack2">
                <Line Text="dlgStarterPackRefusal">
                  <Timer Name="Timer_StarterPack" />
                </Line>
                <Button Type="Right" Color="Beige" Text="OK" />
              </Dialog>
            </Button>
          </Dialog>
          <SetVariable Scope="Users" Name="TmpPackDialogState01" Value="Ended" />
        </Then>
        <Else>
          <SetVariable Scope="Users" Name="TmpPackDialogState01" Value="Wait" />
        </Else>
      </If>
    </Actions>
  </Quest>

  <Quest Name="StarterPackDialogLaunchWait" Unresumable="1" Priority="99999">
    <Events>
      <ChangeTab />
    </Events>
    <Conditions>
      <Equal Value1="?SysInfo[].ChinaF2P" Value2="0" />
      <Equal Value1="_$SceneTo" Value2="Map" />
      <Equal Value1="_TmpPackDialogState01" Value2="Wait" />
