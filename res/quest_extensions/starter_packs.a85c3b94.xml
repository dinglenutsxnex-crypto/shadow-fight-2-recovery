  <Quest Name="OpenRestoredItem" Priority="-100">
    <Events>
      <Activate />
    </Events>
    <Conditions>
      <Equal Value1="_$ActionID" Value2="OpenRestoredItem" />
    </Conditions>
    <Actions>
       <If>
            <Conditions>
            <!-- placed it here coz otherwise it wont be added to stack. these vars are filled after activate action -->
                  <Equal Value1="_RestoredItemToOpen" Value2="0" Not="1" />
                  <Equal Value1="_RestoredItemTabToOpen" Value2="0" Not="1"/>
            </Conditions>
            <Then>
              <OpenShop Tab="_RestoredItemTabToOpen" Item="_RestoredItemToOpen"/>
            </Then>
       </If> 
      <UpdateShopItems />
    </Actions>
  </Quest>
  
  <Quest Name="StarterPackBoughtFirstSuperItem_Activator">
    <Events>
      <Purchase />
    </Events>
    <Conditions>
      <Operator Type="Or">
        <Equal Value1="?Purchase[_$Purchase].Name" Value2="Pack_Starter" />
        <Equal Value1="?Purchase[_$Purchase].Name" Value2="Pack_Starter_2" />
      </Operator>
      <Equal Value1="_$StoryTutorialStep" Value2="END" />
    </Conditions>
    <Actions>
      <Activate ActionID="StarterPackBoughtFirstSuperItem" />
    </Actions>
  </Quest>

  <Quest Name="StarterPackBoughtFirstSuperItem">
    <Events>
      <Activate />
    </Events>
    <Conditions>
      <Equal Value1="_$ActionID" Value2="StarterPackBoughtFirstSuperItem" />
      <Operator Type="Or">
        <GreaterEqual Value1="?Item[Pack_Starter].Quantity" Value2="1" />
        <GreaterEqual Value1="?Item[Pack_Starter_2].Quantity" Value2="1" />
      </Operator>
      <Equal Value1="_FirstSuperItemFlag" Value2="1" Not="1"/>
    </Conditions>
    <Actions>
      <Activate ActionID="StarterPackGive" />
    <Activate ActionID="StarterPackGoToShop" />
      <Dialog Type="Regular" Title="characterMay" Image="character_may_3">
        <Line Text="dlgSuperItemAvailable"/>
        <Button Type="Right" Color="Green" Text="OK" />
      </Dialog>
      <SetVariable Name="FirstSuperItemFlag" Scope="Users" Value="1" />
      <ClearQuestQueue Name="FirstSuperItemAvailable" />
    </Actions>
  </Quest>

  <Quest Name="StarterPackDismiss">
    <Events>
      <TimerEnd />
    </Events>
    <Conditions>
      <Equal Value1="_$TimerName" Value2="Timer_StarterPack" />
    </Conditions>
    <Actions>
      <EndTimer Name="Timer_StarterPack"/>
      <HideMapButton Name="Button_StarterPack"/>
      <SetVariable Name="StarterPackOfferEnded" Scope="Users" Value="1" />
    <SetVariable Name="StarterPack_CheckFight" Scope="Users" Value="1" />
    <Activate ActionID="StarterPackLastChance" />
    </Actions>
  </Quest>

  <Quest Name="StarterPackOnRestart" Priority="10" Unresumable="1">
    <Events>
      <Activate />
    </Events>
    <Conditions>
      <Equal Value1="?SysInfo[].ChinaF2P" Value2="0" />
      <Equal Value1="_$ActionID" Value2="PseudoSessionStart" />
    <Equal Value1="_$InLottery" Value2="1" Not="1" />
      <Greater Value1="?Timer[Timer_StarterPack].Value" Value2="0" />
    </Conditions>
    <Actions>
      <Activate ActionID="StarterPackDialog" />
    </Actions>
  </Quest>
  
  <!-- проверка на выход на карту -->
  <Quest Name="StarterPack_CheckMap" Unresumable="1" Priority="99999">
    <Events>
      <ChangeTab />
    </Events>
    <Conditions>
      <Equal Value1="_StarterPack_CheckFight" Value2="1" />
    </Conditions>
    <Actions>
    <If>
      <Conditions>
        <Equal Value1="_$SceneTo" Value2="Map" />
      </Conditions>
      <Then>
        <Activate ActionID="StarterPackLastChance" />
      </Then>
    </If> 
    <ChangeScene Destination="_$SceneTo" />
    </Actions>
  </Quest>

  <!-- диалог. последний шанс -->
  <Quest Name="StarterPackLastChance" Unresumable="1" Priority="100">
    <Events>
      <Activate />
    </Events>
    <Conditions>
      <Equal Value1="?SysInfo[].ChinaF2P" Value2="0" />
      <Equal Value1="_$ActionID" Value2="StarterPackLastChance" />
    </Conditions>
    <Actions Place="Map">
    <If>
      <Conditions>
        <Equal Value1="_$SceneTo" Value2="Map" />
      </Conditions>
        <Then>
          <SetVariable Name="StarterPack_CheckFight" Scope="Users" Value="0" />
          <EndTimer Name="Timer_StarterPack"/>
          <Dialog Type="Multiline" Title="dlgStarterPackTitle" Image="starter_pack2" ProfitImage="profit50" ImageScale="0.9"> 
            <Line Text="LastChance" />
            <Line Text="LastChance1" />
            <Button Type="Right" Color="Green" Text="dlgStoryBtnShowme" >
              <Dialog Type="Multiline" Title="dlgStarterPackTitle" Image="starter_pack2">
              <Line Text="dlgStarterPackOffer1{img::MiscSprites.tick_red}"/>
              <Line Text="dlgStarterPackOffer2{img::MiscSprites.tick_red}{img::MiscSprites.ruby}{30}"/>
              <Line Text="dlgStarterPackOffer3{img::MiscSprites.tick_red}{img::MiscSprites.gold}{1000}"/>
              <Line Text="dlgStarterPackOffer4{img::MiscSprites.tick_red}" Hide="?SysInfo[].AdvertisingSupport == 0"/>
              <Line Text="dlgStarterPackOffer5{img::MiscSprites.tick_red}"/>
              <PriceLine Text="dlgStarterPackPrice{?Item[Pack_Starter].RealPrice}" TextColor="0xfefe95" />
              <Button Type="Right" Color="Green" Text="dlgBuyButton">
                <BuyItem Name="Pack_Starter" Currency="Real" />
              </Button>
              <Button Type="Left" Color="Red" Text="compareCloseBtn" >
                <ClearQuestQueue Name="StarterPackDialogLastChance" />
              </Button>
              </Dialog>
            </Button>
          </Dialog>
        </Then>
        <Else>
          <ClearQuestQueue Name="StarterPackLastChance" />
        </Else>
      </If> 
    </Actions>
  </Quest>

</Quests>