	<Quest Name="Test_GemsPromo" Priority="9999" Unresumable="0">
		<Actions>
			<EndTimer Name="Timer_IncreasePayment"/>
			<HideMapButton Name="Button_IncreasePayment"/>
			<Switch Value="_GemsPromoCount">
				<Case Value="1">
					<SetVariable Scope="Users" Name="promo_IncreasePayment_Item_Bonus" Value="Bag_Gems"/>
				</Case>
				<Case Value="2">
					<SetVariable Scope="Users" Name="promo_IncreasePayment_Item_Bonus" Value="Chest_Gems"/>
				</Case>
				<Default>
					<SetVariable Scope="Global" Name="GemsPromoCount" Value="0"/>
					<SetVariable Scope="Users" Name="promo_IncreasePayment_Item_Bonus" Value="Casket_Gems"/>
				</Default>
			</Switch>
			<SetVariable Scope="Global" Name="GemsPromoCount" Value="_GemsPromoCount + 1"/>
			<If>
				<Conditions>
					<Operator Type="Or">
						<Equal Value1="_Shroud_Loss" Value2="1"/>
						<Equal Value1="_CurrentZone" Value2="ZONE_7"/>
					</Operator>
				</Conditions>
				<Then>
					<SetVariable Scope="Users" Name="promo_IncreasePayment_Item_Bonus" Value="?Concat[_promo_IncreasePayment_Item_Bonus,@_Zone7]"/>
				</Then>
			</If>
			<SetVariable Scope="Users" Name="promo_PrePurchase" Value="Pile_Gems" />
			<Activate ActionID="IncreasePayment_Launch" />

		</Actions>
	</Quest>

	<Quest Name="Test_CoinsPromo" Priority="9999" Unresumable="0">
		<Actions>
			<EndTimer Name="Timer_IncreasePayment"/>
			<HideMapButton Name="Button_IncreasePayment"/>
			<Switch Value="_CoinsPromoCount">
				<Case Value="1">
					<SetVariable Scope="Users" Name="promo_IncreasePayment_Item_Gold" Value="Chest_Coins"/>
				</Case>
				<Default>
					<SetVariable Scope="Global" Name="CoinsPromoCount" Value="0"/>
					<SetVariable Scope="Users" Name="promo_IncreasePayment_Item_Gold" Value="Bag_Coins"/>
				</Default>
			</Switch>
			
			<SetVariable Scope="Global" Name="CoinsPromoCount" Value="_CoinsPromoCount + 1"/>
			<SetVariable Scope="Global" Name="Zone" Value="?Slice[_CurrentZone,5,10]"/>
			
			<If>
				<Conditions>
					<GreaterEqual Value1="_Zone" Value2="2"/>
					<LessEqual Value1="_Zone" Value2="6"/>
				</Conditions>
				<Then>
					<SetVariable Scope="Users" Name="promo_IncreasePayment_Item_Gold" Value="?Concat[_promo_IncreasePayment_Item_Gold,@_,_Zone]"/>
				</Then>
			</If>
			<If>
				<Conditions>
					<Equal Value1="_Zone" Value2="7"/>
				</Conditions>
				<Then>
					<SetVariable Scope="Users" Name="promo_IncreasePayment_Item_Gold" Value="?Concat[_promo_IncreasePayment_Item_Gold,@_Zone7]"/>
				</Then>
			</If>
			
			<If>
				<Conditions>
					<Equal Value1="_Zone" Value2="IM"/>
				</Conditions>
				<Then>
					<Switch Value="_CurrentDuel">
						<Case Value="ZONE_1|Duel_INTERMISSION|1">
							<SetVariable Scope="Users" Name="promo_IncreasePayment_Item_Gold" Value="Bag_Coins_Platinum"/>
						</Case>
						<Case Value="ZONE_2|Duel_INTERMISSION|1">
							<SetVariable Scope="Users" Name="promo_IncreasePayment_Item_Gold" Value="Bag_Coins_Platinum_2"/>
						</Case>
						<Case Value="ZONE_3|Duel_INTERMISSION|1">
							<SetVariable Scope="Users" Name="promo_IncreasePayment_Item_Gold" Value="Bag_Coins_Platinum_3"/>
						</Case>
						<Case Value="ZONE_4|Duel_INTERMISSION|1">
							<SetVariable Scope="Users" Name="promo_IncreasePayment_Item_Gold" Value="Bag_Coins_Platinum_4"/>
						</Case>
						<Case Value="ZONE_5|Duel_INTERMISSION|1">
							<SetVariable Scope="Users" Name="promo_IncreasePayment_Item_Gold" Value="Bag_Coins_Platinum_5"/>
						</Case>
						<Case Value="ZONE_6|Duel_INTERMISSION|1">
							<SetVariable Scope="Users" Name="promo_IncreasePayment_Item_Gold" Value="Bag_Coins_Platinum_6"/>
						</Case>
						<Default>
						</Default>
					</Switch>
				</Then>
			</If>
			
			<SetVariable Scope="Users" Name="promo_PrePurchase" Value="Pile_Coins" />
			<Activate ActionID="IncreasePayment_Launch" />

		</Actions>
	</Quest>	
	
</Quests>