  <Quest Name="Test_StartEvent" Priority="9999">
	<Events>
		<SessionStart /> 
    </Events>
    <Conditions>
		<Greater Value1="_EventToggleGag" Value2="0"/>
    </Conditions>
	<Actions>
		<Switch Value="_EventToggleGag" >
			<Case Value="1" >
				<SetVariable Scope="Users" Name="EventStart" Value="?SysInfo[].Time - 100"/>  
				<SetVariable Scope="Users" Name="EventEnd" Value="?SysInfo[].Time + 3600"/> 
				<ShowDebugLine Name="EventToggle " Text="_EventToggleGag" Color="{250,250,0}" />
				
			</Case>
			<Case Value="2" >
				<SetVariable Scope="Users" Name="EventStart" Value="?SysInfo[].Time - 500"/>  
				<SetVariable Scope="Users" Name="EventEnd" Value="?SysInfo[].Time -100"/>  
			   <ShowDebugLine Name="EventToggle " Text="_EventToggleGag" Color="{250,250,0}" />

			</Case>
			<Default>
				<ShowDebugLine Name="EventToggle " Text="_EventToggleGag" Color="{250,250,0}" />
			</Default>
		</Switch>

    </Actions>
  </Quest> 
  
  <Quest Name="Test_EventToggle" Priority="9999">
